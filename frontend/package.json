{
  "name": "minitext-frontend",
  "description": "Mintext 一体化 AI 小说与短剧创作工具",
  "author": "Mintext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && node scripts/enable-nsis-built-in-compressor.cjs && electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.mintext.creator.desktop.release",
    "productName": "Mintext",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "extraResources": [
      {
        "from": "../backend/dist/mintext-server.exe",
        "to": "server/mintext-server.exe"
      },
      {
        "from": "../web-ai-adapter",
        "to": "web-ai-adapter",
        "filter": ["package.json", "dist/**/*"]
      },
      {
        "from": "../web-ai-adapter/node_modules/playwright",
        "to": "web-ai-adapter/node_modules/playwright"
      },
      {
        "from": "../web-ai-adapter/node_modules/playwright-core",
        "to": "web-ai-adapter/node_modules/playwright-core"
      },
      {
        "from": "../web-ai-adapter/node_modules/ajv",
        "to": "web-ai-adapter/node_modules/ajv"
      },
      {
        "from": "../web-ai-adapter/node_modules/jsonrepair",
        "to": "web-ai-adapter/node_modules/jsonrepair"
      },
      {
        "from": "../web-ai-adapter/node_modules/fast-deep-equal",
        "to": "web-ai-adapter/node_modules/fast-deep-equal"
      },
      {
        "from": "../web-ai-adapter/node_modules/fast-uri",
        "to": "web-ai-adapter/node_modules/fast-uri"
      },
      {
        "from": "../web-ai-adapter/node_modules/json-schema-traverse",
        "to": "web-ai-adapter/node_modules/json-schema-traverse"
      },
      {
        "from": "../web-ai-adapter/node_modules/require-from-string",
        "to": "web-ai-adapter/node_modules/require-from-string"
      },
      {
        "from": "../browser-extension",
        "to": "browser-extension",
        "filter": ["**/*"]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "executableName": "MintextApp",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
        "perMachine": false,
        "allowElevation": false,
      "include": "build/installer.nsh",
      "shortcutName": "Mintext创作工具",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "useZip": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
