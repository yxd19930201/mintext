# HTTP service
PORT=4310

# Comma-separated providers: deepseek,chatgpt
WEB_AI_ENABLED_PROVIDERS=deepseek,chatgpt

# Runtime data. Use absolute paths when launched by Electron.
WEB_AI_PROFILE_ROOT=.profiles
WEB_AI_IDEMPOTENCY_ROOT=.runtime/idempotency
WEB_AI_DIAGNOSTICS_ROOT=.runtime/diagnostics

# Browser behavior
WEB_AI_HEADLESS=false
WEB_AI_DEFAULT_TIMEOUT_MS=300000
WEB_AI_HARD_TIMEOUT_MS=600000
WEB_AI_LOGIN_TIMEOUT_MS=600000
WEB_AI_PREWARM=true

# Browser selection: msedge, chrome, chromium, or an executable path.
# WEB_AI_BROWSER_CHANNEL=msedge
# WEB_AI_DEEPSEEK_BROWSER_CHANNEL=msedge
# WEB_AI_CHATGPT_BROWSER_CHANNEL=msedge

# Optional JSON provider-definition override.
# WEB_AI_PROVIDER_CONFIG=./providers.local.json
